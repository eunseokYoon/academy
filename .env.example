# --- 로컬 개발 ---
# 로컬 PostgreSQL 컨테이너의 호스트 포트. 비워 두면 5432.
# 호스트에 다른 PostgreSQL이 떠 있을 때만 바꾼다.
DB_PORT=5432

# --- 운영 (EC2의 /opt/academy/.env) ---
# docker-compose.prod.yml이 읽는 값. DB·JWT·S3는 여기가 아니라 /etc/academy/env에 둔다.
DOMAIN=academy.example.com

# 이미지 태그. latest를 쓰지 마라 — 롤백할 대상이 사라진다. 날짜나 커밋 해시를 쓴다.
# 기본값이 없으므로 비워 두면 compose가 에러로 멈춘다. 의도된 동작이다.
TAG=20260730-1420

# 이미지 레지스트리 접두사. ECR이면 {계정}.dkr.ecr.ap-northeast-2.amazonaws.com,
# GHCR이면 ghcr.io/{계정}. 로컬에서 빌드해 직접 올릴 때는 그대로 두면 academy/... 이 된다.
REGISTRY=ghcr.io/your-account
