# 환경변수 — AWS 키와 JWT 시크릿이 들어간다. 절대 커밋하지 말 것
.env
.env.*
!.env.example
# 예외. 시크릿이 아니라 빌드 상수 하나뿐이고, 반드시 커밋돼야 한다 —
# 이 파일이 없으면 `npm run build`가 frontend/.env(개발용 localhost:8080)를 집어서
# 운영 번들이 localhost를 때린다. frontend/.env.production 주석을 봐라.
!.env.production

# backend
backend/build/
backend/.gradle/
backend/out/

# frontend
frontend/node_modules/
frontend/dist/

# IDE
.idea/
*.iml
.vscode/

# OS
.DS_Store

# logs
*.log
.gstack/

# 개발 명세·계약 문서 — 로컬에만 두고 원격에는 올리지 않는다
docs/
spec/
CLAUDE.md

# superpowers 작업 기록 (SDD 원장·리뷰 패키지). 커밋 대상 아님
.superpowers/

# 로컬 실행 스크립트 (환경변수·로컬 시크릿이 들어간다)
backend/run-local.sh
backend/bin/
