# 이 파일은 이미지에 /etc/nginx/templates/default.conf.template 으로 들어간다.
# nginx 공식 이미지의 엔트리포인트가 시작 시 envsubst로 ${DOMAIN}을 치환해
# /etc/nginx/conf.d/default.conf 를 만든다. 도메인을 하드코딩하지 말 것.
#
# $host, $uri 같은 nginx 변수는 그대로 남는다. 엔트리포인트가 실제로 정의된
# 환경변수 이름만 envsubst에 넘기기 때문이다.

server {
    listen 80;
    server_name ${DOMAIN};

    # certbot webroot. 이 블록이 아래 301보다 먼저 와야 갱신이 된다.
    location /.well-known/acme-challenge/ { root /var/www/certbot; }

    # 컨테이너 healthcheck용. 80에만 두는 이유는 인증서 없이도 응답해야 하기 때문이다.
    location /healthz { access_log off; return 200 "ok\n"; }

    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    client_max_body_size 20M;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000" always;

    # 모바일 데이터에서 JS 번들 전송량을 줄인다. 이미지·WebP는 이미 압축돼 있어 제외한다.
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css application/javascript application/json
               image/svg+xml font/woff2;

    # backend는 Compose 서비스 이름이고 127.0.0.11(Docker 내부 DNS)이 해석한다.
    #
    # proxy_pass에 호스트명을 그대로 쓰지 마라. nginx가 설정 로드 시점에 해석해서,
    # backend 컨테이너가 없으면 "host not found in upstream"으로 nginx 자체가 기동에
    # 실패한다. 백엔드 하나 죽은 것으로 정적 화면과 certbot 갱신용 80 포트까지 같이
    # 멈추고, 인증서 만료는 90일 뒤에 발견된다.
    # 변수로 쓰면 요청 시점에 해석하므로 backend가 없을 때 502만 나고 나머지는 산다.
    # 변수를 쓰면 URI가 자동으로 붙지 않으므로 $request_uri를 직접 이어 붙인다.
    #
    # X-Forwarded-Proto가 있어야 Spring이 HTTPS로 인식하고 Secure 쿠키를 처리한다
    # (application.yml의 server.forward-headers-strategy: native와 짝).
    resolver 127.0.0.11 ipv6=off valid=10s;
    location /api/ {
        set $upstream backend:8080;
        proxy_pass http://$upstream$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # 파일명에 해시가 붙으므로 길게 캐시한다.
    location /assets/ {
        root /usr/share/nginx/html;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # SPA 라우팅. 이게 없으면 /parent/attendance 에서 새로고침할 때 404가 난다.
    location / {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
    }
}
