# EC2의 /etc/academy/env 템플릿. backend 컨테이너가 env_file로 읽는다.
#
#   sudo mkdir -p /etc/academy
#   sudo cp academy.env.example /etc/academy/env   # 값을 채운 뒤
#   sudo chmod 600 /etc/academy/env
#
# 이미지에 굽지 마라. Git에 올리지 마라 (이 예시 파일만 커밋한다).
# AWS 액세스 키는 넣지 않는다 — EC2 IAM Role을 쓴다.

# 운영에서는 sslmode=require를 반드시 넣는다.
DB_URL=jdbc:postgresql://{host}:5432/postgres?sslmode=require
DB_USERNAME=
DB_PASSWORD=

# 개발용과 다른 값을 쓴다. 개발 시크릿은 커밋 이력에 남아 있어 토큰을 위조할 수 있다.
#   openssl rand -base64 48
JWT_SECRET=

S3_BUCKET=
AWS_REGION=ap-northeast-2

CORS_ORIGINS=https://{도메인}

# HTTPS 운영에서는 반드시 true. 기본값이 false라(로컬 http용) 빼먹으면
# 리프레시 쿠키에 Secure가 붙지 않는다.
REFRESH_COOKIE_SECURE=true

# 푸시 알림(FCM) 서비스 계정 키. 비워 두면 알림만 안 가고 나머지는 정상 동작한다
# (부팅 로그에 경고가 남는다). 키 파일은 /etc/academy/secrets/firebase-sa.json 에 두고
# 컨테이너 사용자(app, root 아님)가 읽을 수 있게 소유자를 넘긴다 — root 소유 600 이면
# 컨테이너가 못 읽어 부팅이 멈춘다. UID 는 docker exec academy-backend id -u 로 확인한다.
#   sudo chown <UID>:<UID> /etc/academy/secrets/firebase-sa.json
#   sudo chmod 400 /etc/academy/secrets/firebase-sa.json
# compose 가 그 디렉터리를 /run/secrets/academy 로 읽기 전용 마운트한다.
FIREBASE_CREDENTIALS=
